# ── Aplicação ─────────────────────────────────────────────
APP_ENV=dev                 # dev | prod
APP_DEBUG=true

# ── MySQL ─────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ponte_italia
MYSQL_USER=ponte
MYSQL_PASSWORD=ponte
MYSQL_ROOT_PASSWORD=root

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth (JWT) ────────────────────────────────────────────
# mínimo de 32 bytes (RFC 7518) — gere com: openssl rand -hex 32
JWT_SEGREDO=dev-troque-em-producao-por-32-bytes-ou-mais
JWT_EXP_MINUTOS=120

# ── Cofre de documentos ──────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# ── Radar (scraper agendado) ─────────────────────────────
RADAR_INTERVALO_MINUTOS=180
# credenciais usadas pelo scraper para a ingestão autenticada:
PONTE_API=http://localhost:8000
PONTE_EMAIL=
PONTE_SENHA=

# ── Newsletter (Sprint 5) ────────────────────────────────
# hora da curadoria (fuso America/Recife); o disparo é 09h no worker .NET
NEWSLETTER_HORA_CURADORIA=08:30

# SMTP de TESTE em dev: Mailpit do docker-compose (caixa em :8025).
# Em produção, trocar por SendGrid/Resend com domínio verificado (SPF/DKIM) —
# nenhum e-mail real sai do ambiente de desenvolvimento.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USAR_TLS=false
NEWSLETTER_FROM=newsletter@ponteitalia.example
MAILPIT_UI_PORT=8025

# ── Deploy (docker-compose.prod.yml + Caddy) ─────────────
# só usados em produção; o Caddy emite o certificado para este domínio
DOMINIO=ponteitalia.example
ACME_EMAIL=
# disparo imediato da newsletter na subida do worker (demo/operação manual)
NEWSLETTER_DISPARAR_AO_INICIAR=false
